Vagrant.configure("2") do |config|
  config.vm.box = "generic/debian12"
  config.vm.box_version = "4.3.12"
  config.vm.hostname = "hostilyass"

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "hostilyass"
    vb.memory = 2048
    vb.cpus   = 2
  end

  config.vm.provision "linux", type: "shell", path: "provision/linux.sh"
  config.vm.provision "login", type: "shell", path: "provision/login.sh", 
    env: { "PUBLIC_KEY" => File.exist?(File.expand_path("~/.ssh/vm_vagrant.pub")) ? File.read(File.expand_path("~/.ssh/vm_vagrant.pub")).strip : "" }
  config.vm.provision "verify", type: "shell", path: "provision/verify.sh"
end