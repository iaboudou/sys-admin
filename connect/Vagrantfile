Vagrant.configure("2") do |config|
  config.vm.box = "debian-custom"
  config.vm.box_url = "https://media.githubusercontent.com/media/iaboudou/sys-admin/main/box/debian.box"
  config.ssh.username = "ilyass"
  config.ssh.private_key_path = "~/.vagrant.d/insecure_private_keys/vagrant.key.ed25519"
  config.ssh.insert_key = false
  

  config.vm.define "gateway" do  |gateway|
    gateway.vm.hostname = "gateway"
    gateway.vm.provider "virtualbox" do |gw|
      gw.name   = "gateway"
      gw.memory = 2048
      gw.cpus   = 2
    end
    gateway.vm.network "private_network", ip: "192.168.10.1", netmask: "255.255.255.0", virtualbox__intnet: "subnet-a"
    gateway.vm.network "private_network", ip: "192.168.20.1", netmask: "255.255.255.0", virtualbox__intnet: "subnet-b"
    gateway.vm.provision "gateway", type: "shell", path: "provision/gateway.sh"
    gateway.vm.provision "dns", type: "shell", path: "provision/dns.sh"
    gateway.vm.provision "dhcp", type: "shell", path: "provision/dhcp.sh"
  end


  config.vm.define "pc-a" do |pca|
    pca.vm.hostname = "pcA"
    pca.vm.provider "virtualbox" do |a|
      a.name   = "pc-a"
      a.memory = 2048
      a.cpus   = 1
    end
    pca.vm.network "private_network", auto_config: false, virtualbox__intnet: "subnet-a", mac: "080027000a02"
    pca.vm.provision "pc-a", type: "shell", path: "provision/pc-a.sh"
  end


  config.vm.define "pc-b" do |pcb|
    pcb.vm.hostname = "pcB"
    pcb.vm.provider "virtualbox" do |b|
      b.name   = "pc-b"
      b.memory = 2048
      b.cpus   = 1
    end
    pcb.vm.network "private_network", auto_config: false, virtualbox__intnet: "subnet-b"
    pcb.vm.provision "pc-b", type: "shell", path: "provision/pc-b.sh"
  end


  config.vm.provision "linux", type: "shell", path: "provision/linux.sh"
  config.vm.provision "login", type: "shell", path: "provision/login.sh"
  config.vm.provision "shell" do |s|  s.inline = "curl -fsSL https://raw.githubusercontent.com/iaboudou/sys-admin/main/login/verify.sh | bash" end
end